# Raw dataset lives in the Databricks Volume (see docs/deployment-strategy.md),
# not in git — only the data dictionary (documentation, not data) is tracked.
data/*
!data/data_dictionary.md

# Local git worktrees used for isolated plan execution (superpowers:using-git-worktrees).
.worktrees/

# Python artifacts (deploy/scripts/ now has a pytest suite).
__pycache__/
*.pyc
.pytest_cache/
